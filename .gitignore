# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# Build output and caches
.next/
**/.next/
out/
**/out/
build/
**/build/
coverage/
**/coverage/
.cache/
tmp/
*.tsbuildinfo
next-env.d.ts

# Tests are local-only in the runtime-source handoff.
**/*.test.ts
**/*.test.tsx
/apps/api/tests/

# Runtime logs and local process state
*.log
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and secrets
.env
.env.*
src/config/secrets/
!.env.example
!.env.local.example
# Keep production examples local until all real secrets are replaced by placeholders.
.env.production.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# Local editor and AI-agent state
.vscode/
.codex/
.agents/
.agent/
.claude/
.cursor/
.continue/
.hallmark/
.code-review-graph/

# Local dev/deploy state
.nvmrc
.dev/
.tmp_*/
progress/
mysql_data/
redis_data/
certbot/
nginx/

# Local scratch/probe scripts
/scratch*
/test-*.*
/fix_*.js
/start-dev.sh
/deploy_vps.sh
/redeploy_vps.sh
/scripts/
/apps/web/scripts/
/apps/api/alter-master-panels.ts
/apps/api/check-schema.ts
/apps/api/scratch*
/apps/api/check-db.ts
/apps/api/test-db*.ts
/apps/api/test_db.ts
/apps/api/test-json.ts

# Local docs, notes, and generated analysis reports
*.md
!/README.md
/SYSTEM_MAP_WEB.md
/MOBILE_*.md
/PLAN_*.md
/SECURITY_AUDIT.md
/design.md
/apps/web/modules/planning/IMPL_PROMPT_*.md
/apps/web/modules/planning/REFACTOR_*.md

# SQL dumps are local; application migrations are source code.
*.sql
/apps/api/db/migrations/*.sql

# Misc OS/editor files
.DS_Store
*.tmp
*.bak
*.orig
*.swp
*~
