{
  "name": "smsystem",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @smsystem/web",
    "dev:api": "npm run dev --workspace @smsystem/api",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @smsystem/web",
    "start": "npm run start --workspace @smsystem/web",
    "lint": "npm run lint:web",
    "lint:web": "npm run lint --workspace @smsystem/web",
    "test": "bun test apps/api/tests",
    "test:api": "bun test apps/api/tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1049.0",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.575.0",
    "mysql2": "^3.15.3",
    "next": "^16.2.11",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "redis": "^5.9.0",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "postcss": "8.5.23",
    "uuid": "11.1.1",
    "@babel/core": "7.29.7",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "body-parser": "2.3.0",
    "js-yaml": "4.3.1",
    "hono": "4.12.34",
    "@hono/node-server": "1.19.15",
    "ip-address": "10.5.0",
    "brace-expansion@^5.0.5": "5.0.9",
    "brace-expansion@^2.0.1": "2.1.4"
  }
}