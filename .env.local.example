# Copy to .env.local for local development.
# Do not commit real secrets.

# Common
REDIS_PASSWORD=
SPF_API_INTERNAL_URL=http://127.0.0.1:3001

# Mode: local
# Uses local MySQL socket for DB and SSH tunnel only for Redis.
LOCAL_DB_USER=
LOCAL_DB_PASS=
LOCAL_DB_NAME=
LOCAL_PURCHASE_DB_NAME=
LOCAL_WAREHOUSE_DB_NAME=

# Mode: tunnel
# Uses SSH tunnel to backend VPS for MySQL and Redis.
TUNNEL_DB_USER=
TUNNEL_DB_PASS=
TUNNEL_DB_NAME=
TUNNEL_PURCHASE_DB_NAME=
TUNNEL_WAREHOUSE_DB_NAME=
